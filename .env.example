# =====================================================================
# ACL — Automated Comic Localization (.env configuration template)
# Copy this file to `.env` and fill in your values before running.
# =====================================================================

# --- 1. Cloud LLM Translation (Google Gemini) ---
# Fallback Gemini API key if a project has not saved its own encrypted key in Settings UI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- 2. Security & Encryption ---
# Secret used to derive the Fernet key for encrypting project API keys in SQLite.
# If omitted in local dev, ACL auto-generates `.acl_config_secret`.
# ACL_CONFIG_SECRET=replace_with_a_long_random_secret_string

# --- 3. Monthly AI Processing Quota ---
# Max AI translation / pipeline queue requests allowed per project per UTC month (HTTP 429 when exceeded)
ACL_MONTHLY_QUOTA=500

# --- 4. Frontend Origin & CORS (Deployment) ---
# Public frontend URL used when generating password-reset links in emails
APP_BASE_URL=http://localhost:5173
# Comma-separated additional allowed origins for FastAPI CORS middleware in production
# CORS_ORIGINS=https://your-domain.com,https://acl-demo.trycloudflare.com

# --- 5. Password Reset Email Delivery (SendGrid - Optional in Local Dev) ---
# SENDGRID_API_KEY=replace_with_sendgrid_api_key
# SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
