# Use "mock" while the frontend is developed without backend endpoints.
AUTH_BACKEND_MODE=mock

# Switch to "api" and set the backend origin when authentication is available.
# AUTH_BACKEND_MODE=api
# AUTH_API_BASE_URL=http://localhost:8000/api
# AUTH_API_TIMEOUT=10

# Override these only when the backend uses different routes.
# AUTH_LOGIN_PATH=/auth/login
# AUTH_REGISTER_PATH=/auth/register
# AUTH_REFRESH_PATH=/auth/refresh
# AUTH_LOGOUT_PATH=/auth/logout

# Request field mapping. Defaults match the current User database model.
# AUTH_LOGIN_IDENTIFIER_FIELD=email
# AUTH_REGISTER_NAME_FIELD=username

# Frontend quota preview until the backend quota endpoint is available.
QUOTA_BACKEND_MODE=mock
# QUOTA_MOCK_GEMINI_USED=920
# QUOTA_MOCK_GEMINI_LIMIT=1000
# QUOTA_MOCK_OPENAI_USED=72000
# QUOTA_MOCK_OPENAI_LIMIT=100000
